Fix a deadlock when the Android activity pauses while SDL_CreateRenderer runs.

SDL_CreateRenderer takes the activity lock through Android_WaitActiveAndLockActivity(), and
the GLES driver calls it again to create its context. A pause queued between the first call's
check and its lock (the surface may already be destroyed) was only seen by the nested call,
which then waited for the resume while still holding the lock; the main thread needs that lock
to recreate the surface and resume, so neither could go on (an ANR, seen when the activity
pauses during startup, e.g. a theme change right after boot).

Now the outer call handles lifecycle events that came in while it waited for the lock, and if
the activity paused, unlocks and waits for the resume before trying again. A nested call
(the current thread already holds the lock) doesn't wait: the outer call found the activity
running, and the surface can't be destroyed while the lock is held.

Kompoz applies this to SDL 3.4.18 (scripts/fetch-deps.sh).

diff --color -ru a/src/core/android/SDL_android.c b/src/core/android/SDL_android.c
--- a/src/core/android/SDL_android.c	2026-10-04 01:50:40.048680851 +0300
+++ b/src/core/android/SDL_android.c	2026-10-04 01:50:40.066654600 +0300
@@ -1018,16 +1018,26 @@
     return got_event;
 }
 
+// How deep the current thread holds the activity mutex through the two functions below.
+static __thread int Android_ActivityMutexDepth = 0;
+
 void Android_LockActivityMutex(void)
 {
     SDL_LockMutex(Android_ActivityMutex);
+    ++Android_ActivityMutexDepth;
 }
 
 void Android_UnlockActivityMutex(void)
 {
+    --Android_ActivityMutexDepth;
     SDL_UnlockMutex(Android_ActivityMutex);
 }
 
+bool Android_HoldsActivityMutex(void)
+{
+    return Android_ActivityMutexDepth > 0;
+}
+
 // Drop file
 JNIEXPORT void JNICALL SDL_JAVA_INTERFACE(onNativeDropFile)(
     JNIEnv *env, jclass jcls,
diff --color -ru a/src/core/android/SDL_android.h b/src/core/android/SDL_android.h
--- a/src/core/android/SDL_android.h	2026-10-04 01:50:40.053567159 +0300
+++ b/src/core/android/SDL_android.h	2026-10-04 01:50:40.066700519 +0300
@@ -54,6 +54,7 @@
 
 void Android_LockActivityMutex(void);
 void Android_UnlockActivityMutex(void);
+bool Android_HoldsActivityMutex(void);
 
 void Android_SetAllowRecreateActivity(bool enabled);
 
diff --color -ru a/src/video/android/SDL_androidevents.c b/src/video/android/SDL_androidevents.c
--- a/src/video/android/SDL_androidevents.c	2026-10-04 01:50:40.057753517 +0300
+++ b/src/video/android/SDL_androidevents.c	2026-10-04 01:50:40.066725131 +0300
@@ -240,23 +240,43 @@
 
 bool Android_WaitActiveAndLockActivity(void)
 {
-    /* Make sure we have pumped all events so that Android_Paused state is correct */
     SDL_AndroidLifecycleEvent event;
-    while (!Android_Destroyed && Android_WaitLifecycleEvent(&event, 0)) {
-        Android_HandleLifecycleEvent(event);
-    }
 
-    while (Android_Paused && !Android_Destroyed) {
-        Android_PumpEvents(-1);
+    /* Already holding the activity lock (SDL_CreateRenderer making its GL context): the outer
+     * call found the activity running when it locked, and the main thread can't destroy the
+     * surface without the lock, so waiting for a resume here could only deadlock with it. */
+    if (Android_HoldsActivityMutex()) {
+        Android_LockActivityMutex();
+        return true;
     }
 
-    if (Android_Destroyed) {
-        SDL_SetError("Android activity has been destroyed");
-        return false;
-    }
+    for (;;) {
+        /* Make sure we have pumped all events so that Android_Paused state is correct */
+        while (!Android_Destroyed && Android_WaitLifecycleEvent(&event, 0)) {
+            Android_HandleLifecycleEvent(event);
+        }
+
+        while (Android_Paused && !Android_Destroyed) {
+            Android_PumpEvents(-1);
+        }
 
-    Android_LockActivityMutex();
-    return true;
+        if (Android_Destroyed) {
+            SDL_SetError("Android activity has been destroyed");
+            return false;
+        }
+
+        Android_LockActivityMutex();
+
+        /* A pause that came in meanwhile, its surface maybe gone already: let it through and
+         * wait for the resume without the lock (the main thread needs it to resume). */
+        while (!Android_Destroyed && Android_WaitLifecycleEvent(&event, 0)) {
+            Android_HandleLifecycleEvent(event);
+        }
+        if (!Android_Paused && !Android_Destroyed) {
+            return true;
+        }
+        Android_UnlockActivityMutex();
+    }
 }
 
 void Android_QuitEvents(void)
