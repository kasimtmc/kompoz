# ThreadSanitizer: what isn't Kompoz's own code and isn't built with it.
#
# lavapipe (Mesa's Vulkan on the CPU) and the LLVM it compiles shaders with run threads of their own and synchronize
# them in code ThreadSanitizer doesn't see; what they free, copy or lock through its interceptors is reported as
# racing with their own threads. Neither calls back into Kompoz, so a report with their frames is theirs.
race:libvulkan_lvp.so
race:libLLVM
deadlock:libLLVM
