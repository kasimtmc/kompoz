# AsyncImage's libraries on Linux and macOS (Windows, Android and the web decode and download with
# their own): libjpeg-turbo for JPEG (its TurboJPEG 3 API from 3.0, the one before on 2.x),
# libwebp for WebP and libcurl for HTTP. libjpeg-turbo and libwebp come from pkg-config where it is
# (a system's; Ubuntu 24.04's libjpeg-turbo CMake package names a file its package lacks, which
# stops CMake) or else from their CMake packages (vcpkg, Conan, which turn pkg-config off); libcurl
# from its CMake package or else CMake's FindCURL. Kompoz's build and its installed package both
# find them here, the package the same way the build did.
#
#   kompoz_find_image_library(<JPEG|WEBP|CURL> <AUTO|ON|OFF> [HOW <CONFIG|PKGCONFIG|MODULE>])
#
# AUTO: used when found; ON: required; OFF: not used. HOW: only that way. Sets KOMPOZ_<lib>_TARGET
# (the imported target to link, empty when not used), KOMPOZ_<lib>_HOW (how it was found) and, for
# JPEG, KOMPOZ_JPEG_VERSION.
function(kompoz_find_image_library lib mode)
    cmake_parse_arguments(arg "" "HOW" "" ${ARGN})
    set(target "")
    set(how "")
    set(version "")
    macro(kompoz_try way)
        if(NOT target AND (NOT arg_HOW OR arg_HOW STREQUAL "${way}"))
            set(kompoz_trying ON)
        else()
            set(kompoz_trying OFF)
        endif()
    endmacro()
    macro(kompoz_pkg_config module prefix)
        find_package(PkgConfig QUIET)
        if(PkgConfig_FOUND)
            pkg_check_modules(${prefix} QUIET IMPORTED_TARGET ${module})
            if(${prefix}_FOUND)
                set(target PkgConfig::${prefix})
                set(how PKGCONFIG)
                set(version ${${prefix}_VERSION})
            endif()
        endif()
    endmacro()
    if(NOT mode STREQUAL "OFF")
        if(lib STREQUAL "JPEG")
            kompoz_try(PKGCONFIG)
            if(kompoz_trying)
                kompoz_pkg_config(libturbojpeg kompoz_pc_turbojpeg)
            endif()
            kompoz_try(CONFIG)
            if(kompoz_trying)
                find_package(libjpeg-turbo CONFIG QUIET)
                foreach(candidate libjpeg-turbo::turbojpeg libjpeg-turbo::turbojpeg-static)
                    if(NOT target AND TARGET ${candidate})
                        set(target ${candidate})
                        set(how CONFIG)
                        set(version ${libjpeg-turbo_VERSION})
                    endif()
                endforeach()
            endif()
        elseif(lib STREQUAL "WEBP")
            kompoz_try(PKGCONFIG)
            if(kompoz_trying)
                kompoz_pkg_config(libwebp kompoz_pc_webp)
            endif()
            kompoz_try(CONFIG)
            if(kompoz_trying)
                find_package(WebP CONFIG QUIET)
                if(TARGET WebP::webp)
                    set(target WebP::webp)
                    set(how CONFIG)
                endif()
            endif()
        elseif(lib STREQUAL "CURL")
            kompoz_try(CONFIG)  # curl's own CMake package (vcpkg, Conan, some systems)
            if(kompoz_trying)
                find_package(CURL CONFIG QUIET)
                if(TARGET CURL::libcurl)
                    set(target CURL::libcurl)
                    set(how CONFIG)
                endif()
            endif()
            kompoz_try(MODULE)  # else CMake's FindCURL
            if(kompoz_trying)
                find_package(CURL MODULE QUIET)
                if(TARGET CURL::libcurl)
                    set(target CURL::libcurl)
                    set(how MODULE)
                endif()
            endif()
        else()
            message(FATAL_ERROR "kompoz_find_image_library: no library ${lib} (JPEG, WEBP, CURL)")
        endif()
    endif()
    if(mode STREQUAL "ON" AND NOT target)
        message(FATAL_ERROR "Kompoz: ${lib} is required (KOMPOZ_WITH_${lib}=ON) but wasn't found")
    endif()
    set(KOMPOZ_${lib}_TARGET "${target}" PARENT_SCOPE)
    set(KOMPOZ_${lib}_HOW "${how}" PARENT_SCOPE)
    if(lib STREQUAL "JPEG")
        set(KOMPOZ_JPEG_VERSION "${version}" PARENT_SCOPE)
    endif()
endfunction()
