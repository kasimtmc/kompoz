<idea-plugin>
    <id>dev.kompoz.kompozable</id>
    <name>Kompoz</name>
    <vendor url="https://github.com/kasimtmc/kompoz">Kompoz</vendor>
    <description><![CDATA[
        For C++ sources with <code>@Kompozable</code> functions written in Kotlin's syntax (Kompoz's
        <code>kompozable</code>): kompozc's language server, <code>kompozc --lsp</code>, in front of clangd.
        In such a file CLion's own C++ highlighting is turned off (it would read the Kotlin as broken C++);
        kompozc's errors, and the C++ compiler's on the translation, show on their own lines, and clangd's
        answers in the C++ around the Kotlin.
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lsp</depends>

    <extensions defaultExtensionNs="com.intellij">
        <platform.lsp.integrationProvider implementation="dev.kompoz.clion.KompozLspIntegrationProvider"/>
        <applicationConfigurable parentId="tools" instance="dev.kompoz.clion.KompozConfigurable" id="dev.kompoz.kompozable.settings"
                                 displayName="Kompoz"/>
    </extensions>

    <projectListeners>
        <listener class="dev.kompoz.clion.KompozEditorListener" topic="com.intellij.openapi.fileEditor.FileEditorManagerListener"/>
        <listener class="dev.kompoz.clion.KompozHighlightingListener"
                  topic="com.intellij.codeInsight.daemon.impl.analysis.FileHighlightingSettingListener"/>
    </projectListeners>
</idea-plugin>
