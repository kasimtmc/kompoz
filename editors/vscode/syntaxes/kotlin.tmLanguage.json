{
  "$comment": "Kotlin as Kompoz's sources have it (@Kompozable functions, Compose's code): comments, strings with templates, numbers, annotations, keywords, declarations, calls, types, labels.",
  "name": "Kotlin (Kompoz)",
  "scopeName": "source.kotlin.kompoz",
  "patterns": [
    {
      "include": "#code"
    }
  ],
  "repository": {
    "code": {
      "patterns": [
        {
          "include": "#comments"
        },
        {
          "include": "#strings"
        },
        {
          "include": "#characters"
        },
        {
          "include": "#annotations"
        },
        {
          "include": "#declarations"
        },
        {
          "include": "#labels"
        },
        {
          "include": "#keywords"
        },
        {
          "include": "#numbers"
        },
        {
          "include": "#calls"
        },
        {
          "include": "#types"
        },
        {
          "include": "#operators"
        },
        {
          "include": "#braces"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.block.kotlin",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kotlin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kotlin"
            }
          },
          "patterns": [
            {
              "include": "#comments"
            }
          ]
        },
        {
          "name": "comment.line.double-slash.kotlin",
          "begin": "//",
          "end": "$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.kotlin"
            }
          }
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.kotlin",
          "begin": "\"\"\"",
          "end": "\"\"\"(?!\")",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.kotlin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.kotlin"
            }
          },
          "patterns": [
            {
              "include": "#templates"
            }
          ]
        },
        {
          "name": "string.quoted.double.kotlin",
          "begin": "\"",
          "end": "\"|$",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.string.begin.kotlin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.string.end.kotlin"
            }
          },
          "patterns": [
            {
              "include": "#escapes"
            },
            {
              "include": "#templates"
            }
          ]
        }
      ]
    },
    "escapes": {
      "name": "constant.character.escape.kotlin",
      "match": "\\\\(?:u[0-9A-Fa-f]{4}|[tbnr'\"\\\\$])"
    },
    "templates": {
      "patterns": [
        {
          "name": "meta.template.expression.kotlin",
          "begin": "\\$\\{",
          "end": "\\}",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.begin.kotlin"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.template-expression.end.kotlin"
            }
          },
          "contentName": "meta.embedded.line.kotlin",
          "patterns": [
            {
              "include": "#code"
            }
          ]
        },
        {
          "match": "(\\$)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "punctuation.definition.template-expression.kotlin"
            },
            "2": {
              "name": "variable.other.template.kotlin"
            }
          }
        }
      ]
    },
    "characters": {
      "name": "string.quoted.single.kotlin",
      "match": "'(?:\\\\(?:u[0-9A-Fa-f]{4}|[tbnr'\"\\\\$])|[^'\\\\])'"
    },
    "annotations": {
      "match": "(@)([A-Za-z_][A-Za-z0-9_]*(?:\\.[A-Za-z_][A-Za-z0-9_]*)*)(?::[A-Za-z_][A-Za-z0-9_]*)?",
      "captures": {
        "0": {
          "name": "storage.type.annotation.kotlin"
        },
        "1": {
          "name": "punctuation.definition.annotation.kotlin"
        }
      }
    },
    "declarations": {
      "patterns": [
        {
          "$comment": "fun <T> Receiver.name(",
          "match": "\\b(fun)\\b\\s*(?:<[^>]*>\\s*)?(?:([A-Za-z_][A-Za-z0-9_<>?, ]*)\\.)?([A-Za-z_][A-Za-z0-9_]*|`[^`]+`)",
          "captures": {
            "1": {
              "name": "storage.type.function.kotlin"
            },
            "2": {
              "name": "entity.name.type.kotlin"
            },
            "3": {
              "name": "entity.name.function.kotlin"
            }
          }
        },
        {
          "match": "\\b(class|interface|object|typealias)\\b\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.class.kotlin"
            },
            "2": {
              "name": "entity.name.type.class.kotlin"
            }
          }
        },
        {
          "match": "\\b(val|var)\\b\\s*(?:<[^>]*>\\s*)?(?:([A-Za-z_][A-Za-z0-9_<>?, ]*)\\.)?([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "storage.type.variable.kotlin"
            },
            "2": {
              "name": "entity.name.type.kotlin"
            },
            "3": {
              "name": "variable.other.declaration.kotlin"
            }
          }
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "match": "\\b(return|break|continue|this|super)(@)([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": {
              "name": "keyword.control.kotlin"
            },
            "2": {
              "name": "punctuation.definition.label.kotlin"
            },
            "3": {
              "name": "entity.name.label.kotlin"
            }
          }
        },
        {
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(@)(?=\\s*[{(]|\\s+(?:for|while|do)\\b)",
          "captures": {
            "1": {
              "name": "entity.name.label.kotlin"
            },
            "2": {
              "name": "punctuation.definition.label.kotlin"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kotlin",
          "match": "\\b(if|else|when|for|while|do|return|break|continue|throw|try|catch|finally)\\b"
        },
        {
          "name": "keyword.operator.type.kotlin",
          "match": "\\b(is|as|in)\\b|!is\\b|!in\\b|\\bas\\?"
        },
        {
          "name": "storage.type.kotlin",
          "match": "\\b(fun|val|var|class|interface|object|typealias|constructor|init|get|set|by|companion|where|import|package)\\b"
        },
        {
          "name": "storage.modifier.kotlin",
          "match": "\\b(private|protected|public|internal|open|abstract|final|override|sealed|data|enum|inner|annotation|value|suspend|inline|noinline|crossinline|reified|lateinit|const|operator|infix|tailrec|vararg|external|expect|actual|out)\\b"
        },
        {
          "name": "constant.language.kotlin",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.kotlin",
          "match": "\\b(this|super|it|field)\\b"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.kotlin",
          "match": "\\b0[xX][0-9A-Fa-f_]+[uU]?[lL]?\\b"
        },
        {
          "name": "constant.numeric.binary.kotlin",
          "match": "\\b0[bB][01_]+[uU]?[lL]?\\b"
        },
        {
          "name": "constant.numeric.decimal.kotlin",
          "match": "(?<![A-Za-z0-9_])(?:[0-9][0-9_]*(?:\\.[0-9][0-9_]*)?|\\.[0-9][0-9_]*)(?:[eE][+-]?[0-9]+)?(?:[fFdD]|[uU]?[lL]|[uU])?(?![A-Za-z0-9_])"
        }
      ]
    },
    "calls": {
      "match": "\\b([A-Za-z_][A-Za-z0-9_]*)(?=\\s*(?:<[A-Za-z0-9_<>?, .]*>)?\\s*[({])",
      "captures": {
        "1": {
          "name": "entity.name.function.call.kotlin"
        }
      }
    },
    "types": {
      "name": "entity.name.type.kotlin",
      "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.elvis.kotlin",
          "match": "\\?:"
        },
        {
          "name": "keyword.operator.safe-call.kotlin",
          "match": "\\?\\."
        },
        {
          "name": "keyword.operator.not-null.kotlin",
          "match": "!!"
        },
        {
          "name": "keyword.operator.arrow.kotlin",
          "match": "->"
        },
        {
          "name": "keyword.operator.reference.kotlin",
          "match": "::"
        },
        {
          "name": "keyword.operator.range.kotlin",
          "match": "\\.\\.<?"
        },
        {
          "name": "keyword.operator.comparison.kotlin",
          "match": "===?|!==?|<=|>="
        },
        {
          "name": "keyword.operator.assignment.kotlin",
          "match": "[-+*/%]?="
        },
        {
          "name": "keyword.operator.logical.kotlin",
          "match": "&&|\\|\\||!"
        },
        {
          "name": "keyword.operator.arithmetic.kotlin",
          "match": "\\+\\+|--|[-+*/%]"
        }
      ]
    },
    "braces": {
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.block.begin.kotlin"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.section.block.end.kotlin"
        }
      },
      "patterns": [
        {
          "include": "#code"
        }
      ]
    }
  }
}
